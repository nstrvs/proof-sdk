# Optional telemetry toggle.
VITE_ENABLE_TELEMETRY=false

# Optional app version tag for event properties
VITE_APP_VERSION=dev

# Vite dev only: editor UI runs on 3000 and talks to this API server.
VITE_PROOF_DEV_SERVER_ORIGIN=http://localhost:4000

# Local API server started by `npm run serve`.
PROOF_SERVER_PORT=4000
# Optional bind host; leave unset for Node's default listener.
# PROOF_SERVER_HOST=0.0.0.0

# Public browser origin for generated share links.
PROOF_PUBLIC_BASE_URL=http://localhost:3000
PROOF_PUBLIC_ORIGIN=http://localhost:3000

# The API server hosts the embedded collaboration websocket.
COLLAB_EMBEDDED_WS=1
COLLAB_PUBLIC_BASE_URL=ws://localhost:4000/ws

# Stable local signing key for collaboration sessions.
# Generate one with: openssl rand -hex 32
PROOF_COLLAB_SIGNING_SECRET=
